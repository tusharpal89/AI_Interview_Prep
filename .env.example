# ---------------- LLM (the AI brain) ----------------
# Provider: groq (fast + free) | gemini (free) | openai | ollama
LLM_PROVIDER=groq
# Groq (recommended - fast + free): get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq chat models: openai/gpt-oss-120b (best) | openai/gpt-oss-20b (faster) | qwen/qwen3.8-27b
LLM_MODEL=openai/gpt-oss-120b
# Gemini (free): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (normally leave blank)
# OPENAI_API_KEY=
# LLM_BASE_URL=

# ---------------- Voice (speech-to-text) ----------------
# Voice answers are transcribed with Groq's Whisper API (needs GROQ_API_KEY)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
MAX_UPLOAD_MB=25

# ---------------- Frontend ----------------
BACKEND_URL=http://localhost:8001
